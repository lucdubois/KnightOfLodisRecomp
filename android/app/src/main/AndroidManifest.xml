<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:glEsVersion="0x00020000" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />
    <!-- Options > Rumble: the device's vibrator (Rumble.java). -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Options > Achievements: RetroAchievements (Cheevos.java). Only
         retroachievements.org is contacted, only once a player logs in. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- VS Mode over the network (kol_vs_net.cpp, VsCopy.java): the two games
         find each other by UDP broadcast on the local network, which Android
         delivers only while a multicast lock is held. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- The icon is the emblem medallion (res/mipmap-*; made by
         koldecomp/medallion_detail/icon_render.py + icon_res.py). -->
    <application
        android:label="Knight of Lodis"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:supportsRtl="true">

        <!-- Launcher entry: provisions the ROM and BIOS before any native code
             runs. The runtime hash-verifies both at startup and refuses to
             boot without them, so SDLActivity must not start first. -->
        <activity
            android:name=".SetupActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The game itself. Landscape: the GBA is 3:2 and the Thor is a
             landscape handheld. -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:launchMode="singleTask"
            android:configChanges="orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation"
            />

        <!-- Sync Folder's folder picker over the game (FolderPickActivity.java):
             invisible, so the game stays behind it. -->
        <activity
            android:name=".FolderPickActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true" />

        <!-- Restarts the app (RestartActivity.java): its own process, so the
             game's can end first. Invisible. -->
        <activity
            android:name=".RestartActivity"
            android:exported="false"
            android:process=":restart"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true" />

        <!-- VS Mode's unseen copy of the game (VsCopyService.java): its own
             process, as the native runtime runs once per process. -->
        <service
            android:name=".VsCopyService"
            android:exported="false"
            android:process=":vscopy" />

        <!-- The save and the save states in Android's Files app
             (SavesProvider.java). Only the system's file picker may ask. -->
        <provider
            android:name=".SavesProvider"
            android:authorities="${applicationId}.documents"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>
    </application>
</manifest>
